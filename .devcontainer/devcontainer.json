{
  "build": {
    "args": {
      "NODE_VERSION": "24",
      "PACKAGE_MANAGER_PIN": "pnpm@12.5.1",
      "PLAYWRIGHT_CLI_PACKAGE": "@playwright/test@^1.62.1"
    },
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": ["oxc.oxc-vscode"]
    }
  },
  "mounts": [
    {
      "source": "${devcontainerId}-pnpm-store",
      "target": "/pnpm/store",
      "type": "volume"
    }
  ],
  "name": "off-peak-calendar"
}
