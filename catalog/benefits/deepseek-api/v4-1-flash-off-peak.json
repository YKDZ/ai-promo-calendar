{
  "$schema": "../../schema/benefit.schema.json",
  "schemaVersion": 1,
  "accessChannelId": "deepseek-api",
  "id": "v4-1-flash-off-peak",
  "title": "DeepSeek-V4.1-Flash 自营 API 闲时半价",
  "evidenceStatus": "supported",
  "sourceReferences": [
    "https://api-docs.deepseek.com/zh-cn/quick_start/pricing/",
    "https://api-docs.deepseek.com/zh-cn/news/news260910/"
  ],
  "eligibilityConditions": [
    {
      "kind": "one_of",
      "field": "model",
      "values": [
        "deepseek-flash",
        "deepseek-v4-flash",
        "deepseek-v4-flash-vision-exp"
      ]
    },
    {
      "kind": "text",
      "description": "仅适用于 DeepSeek 自营 API 当前 DeepSeek-V4.1-Flash，同时支持思考与非思考模式；不是第三方平台同名模型的计费。"
    },
    {
      "kind": "text",
      "description": "旧模型已经下线；兼容名称 deepseek-v4-flash、deepseek-v4-flash-vision-exp 的请求现路由至 V4.1 Flash 并按 Flash 价格计费。"
    },
    {
      "kind": "text",
      "description": "费率保留中文官方价目表的人民币与每 1M tokens 单位；regular 为高峰单价、benefit 为闲时单价。输入缓存命中、未命中和输出分别计费。"
    }
  ],
  "timeCondition": {
    "kind": "unresolved",
    "publishedText": "新价格自北京时间 2026-09-10 12:00 起生效；北京时间周一至周五（不含中国法定节假日）09:00-12:00、14:00-18:00 为高峰，其余时段（含周末和中国法定节假日全天）为空闲时段。",
    "reason": "现行规则明确包含中国法定节假日例外，但目录尚未嵌入可逐日核对的官方节假日日历；若只写普通周循环会把法定节假日误判为工作日，故暂不把规则强行求值为 recurring。"
  },
  "effect": {
