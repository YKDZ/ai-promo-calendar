  "eligibilityConditions": [
    {
      "kind": "one_of",
      "field": "model",
      "values": [
        "qwen3.8-max",
        "qwen3.8-max-preview",
        "deepseek-v4-pro-0813",
        "deepseek-v4-flash-0731",
        "deepseek-v4.1-flash"
      ]
    },
    {
      "kind": "one_of",
      "field": "plan_tier",
      "values": ["Lite", "Essential", "Standard", "Pro"]
