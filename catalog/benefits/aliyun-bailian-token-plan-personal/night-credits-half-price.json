    { "kind": "one_of", "field": "region", "values": ["华北2（北京）"] },
    {
      "kind": "text",
      "description": "仅限兼容的 AI 编程和智能体工具中的交互式使用；不用于自动化脚本、应用后端或非交互批量任务。Claude Code、Qwen Code、Qoder、Qoder CN、OpenClaw 等为兼容示例，不是封闭工具清单。"
    },
    {
      "kind": "text",
      "description": "个人版 API Key 仅供订阅所属用户本人在单台设备上使用，不共享；所用额度与调用权限须有效。qwen3.8-max-preview 会路由至正式 qwen3.8-max，Credits 抵扣和用量统计按正式版计算。"
    },
    {
      "kind": "text",
      "description": "独立计费的 Harness 工具不自动纳入本项模型优惠。"
    }
  ],
  "timeTrigger": { "kind": "model_request" },
  "timeCondition": {
    "kind": "recurring",
    "timeZone": "Etc/GMT-8",
    "sourceTimeZoneText": "UTC+8",
    "windows": [
      { "weekdays": [1, 2, 3, 4, 5, 6, 7], "start": "22:00", "end": "08:00" }
    ]
  },
  "effect": {
    "kind": "multiplier",
    "target": "credits",
    "unit": "Credits",
    "value": "0.5"
  }
