{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "官方发现入口清单",
  "description": "供维护者巡查新活动的公开文档、价目表、更新日志和索引。入口只是搜索线索，本文件不声明任何时段权益生效。",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "entries"],
  "properties": {
    "$schema": { "const": "schema/discovery.schema.json" },
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "description": "维护者应逐项查看并继续搜索更广的一手来源；不得把清单完整性当作所有优惠已收录的保证。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "description"],
        "properties": {
          "title": {
            "type": "string",
            "pattern": "\\S",
            "description": "入口的简短名称，说明实际计费渠道或文档集合。"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://\\S+$",
            "description": "值得广泛巡查的公开文档入口；若它载明具体权益，也必须另在权益记录中引用。"
          },
          "description": {
            "type": "string",
            "pattern": "\\S",
            "description": "说明该入口适合调查什么，及不能从它直接推断什么。"
          }
        }
      }
    }
  }
}
