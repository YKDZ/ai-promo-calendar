{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "独立计费渠道记录",
  "description": "一个文件对应一个实际承担计费规则的使用渠道，即使该渠道当前没有时段权益也可保留。模型研发方与计费方可能不同。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "billingProvider",
    "accessChannel",
    "sourceReferences"
  ],
  "properties": {
    "$schema": { "const": "../schema/channel.schema.json" },
    "schemaVersion": { "const": 1 },
    "billingProvider": {
      "$ref": "#/$defs/text",
      "description": "对本使用渠道的费用或额度规则负责的主体名称，不一定是所用模型的研发方；此处不另造无可核对目标的服务商 ID。"
    },
    "accessChannel": {
      "type": "object",
      "description": "按该主体条款付费或扣减额度的渠道；独立 API 与不同套餐不要因模型名相同而合并。",
      "additionalProperties": false,
      "required": ["id", "name", "kind"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "稳定渠道 ID，必须与文件名以及权益文件的 accessChannelId 一致。"
        },
        "name": { "$ref": "#/$defs/text" },
        "kind": {
          "enum": ["metered_api", "plan", "other"],
          "description": "metered_api 为按量 API；plan 为订阅或额度套餐；other 仅用于确实不同的计费方式。"
        }
      }
    },
    "sourceReferences": {
      "$ref": "#/$defs/sourceReferences",
      "description": "直接支持渠道身份、计费主体和适用范围的公开 URL，不等于该渠道每项权益的证据。"
    },
    "billingDecisionInstant": {
      "type": "object",
      "description": "仅在计费方明确说明以何时刻判定请求费率时填写；政策窗口不推定最终账单时刻。",
      "additionalProperties": false,
      "required": ["kind", "description", "sourceReferences"],
      "properties": {
        "kind": { "enum": ["request_started", "server_received", "other"] },
        "description": { "$ref": "#/$defs/text" },
        "sourceReferences": { "$ref": "#/$defs/sourceReferences" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "text": { "type": "string", "pattern": "\\S" },
    "sourceReferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https?://\\S+$" }
    }
  }
}
