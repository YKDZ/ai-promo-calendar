{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "独立计费渠道记录",
  "description": "一个实际负责计费或额度扣减的使用渠道；与模型研发方、其他套餐或独立代理渠道分别记录。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "billingProvider",
    "accessChannel",
    "sourceReferences"
  ],
  "properties": {
    "$schema": {
      "const": "../schema/channel.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "billingProvider": {
      "$ref": "#/$defs/billingProvider"
    },
    "accessChannel": {
      "$ref": "#/$defs/accessChannel"
    },
    "sourceReferences": {
      "$ref": "#/$defs/sourceReferences"
    },
    "billingDecisionInstant": {
      "type": "object",
      "description": "仅在计费方明确说明以请求的何时刻判定费率时填写；事件类别和政策窗口本身不推定判定时刻，其他机制应先扩展契约。",
      "additionalProperties": false,
      "required": ["kind", "sourceReferences"],
      "properties": {
        "kind": {
          "enum": ["request_started", "server_received"]
        },
        "sourceReferences": {
          "$ref": "#/$defs/sourceReferences"
        }
      }
    }
  },
  "$defs": {
    "billingProvider": {
      "type": "string",
      "pattern": "\\S",
      "description": "对本使用渠道的费用或额度规则负责的主体名称，不一定是所用模型的研发方；此处不另造无可核对目标的服务商 ID。"
    },
    "accessChannel": {
      "type": "object",
      "description": "按该主体条款付费或扣减额度的渠道；独立 API 与不同套餐不要因模型名相同而合并。",
      "additionalProperties": false,
      "required": ["id", "name", "kind"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "稳定渠道 ID，必须与文件名以及权益文件的 accessChannelId 一致。"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "enum": ["metered_api", "plan", "other"],
          "description": "metered_api 为按量 API；plan 为订阅或额度套餐；other 仅用于确实不同的计费方式。"
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "sourceReferences": {
      "type": "array",
      "description": "直接支持渠道身份、计费主体和适用范围的公开 URL，不等于该渠道每项权益的证据。",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https?://\\S+$"
      }
    }
  }
}
