{
  "name": "@off-peak-calendar/catalog",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "format:check": "oxfmt --list-different --config ../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --config ../oxlint.config.ts .",
    "lint:fix": "oxlint --format=unix --config ../oxlint.config.ts . --fix",
    "test": "node --conditions=source --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "validate:catalog": "node --conditions=source --test test/catalog-files.test.ts"
  },
  "dependencies": {
    "ajv": "catalog:"
  },
  "devDependencies": {
    "@off-peak-calendar/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "24"
  }
}
